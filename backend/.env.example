# Backend server
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8000
JARVIS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# Provider selection: auto, openai, groq, local
JARVIS_PROVIDER=auto

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Google OAuth (Gmail send) — see Task 1 for setup steps
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/gmail/callback

# Tavily web search — see Task 1 for setup steps
TAVILY_API_KEY=

# YouTube Data API v3 — see Task 1 for setup steps
YOUTUBE_API_KEY=

# Finnhub market data — see Task 1 for setup steps
FINNHUB_API_KEY=

# TV control (direct integration, no Home Assistant) — see Task 1 for setup
TCL_TV_IP=
TCL_TV_MAC=
SAMSUNG_TV_IP=
SAMSUNG_TV_MAC=
LG_TV_IP=
LG_TV_MAC=

# Interim API gate (stopgap ahead of real auth) — frontend sends this as X-Jarvis-Key.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JARVIS_API_KEY=

# Encrypts Google OAuth tokens at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
